# Reading Buddy TTS — environment variables
# Copy to .env:  cp .env.example .env

# ── AWS Polly (default — used by npm run generate-audio) ──
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural

# Or use an AWS CLI profile instead of keys above:
# AWS_PROFILE=your-profile

# Delay between Polly requests when batch-generating (ms)
TTS_DELAY_MS=120

# ── ElevenLabs (optional alternative) ──
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Dev TTS server port (npm run dev:tts)
TTS_PORT=3001
