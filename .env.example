# TTS server (dev + Lambda)
# Copy to .env and fill in for Polly or ElevenLabs

# AWS Polly (default)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural

# Or ElevenLabs
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# Dev server port
TTS_PORT=3001

# Batch clip generation target
# TTS_API_URL=http://localhost:3001/api/tts
